{
  "name": "djvureader",
  "version": "1.0.0",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.7.0"
  },
  "scripts": {
    "start": "electron main.js",
    "start:dev": "ELECTRON_START_URL=http://localhost:4200 electron main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder --mac",
    "pack": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.irynashepilova.djvureader",
    "productName": "Djvu Reader",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "!build/**"
    ],
    "mac": {
      "category": "public.app-category.books",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": [
          "djvu",
          "djv"
        ],
        "name": "DjVu Document",
        "description": "DjVu document",
        "role": "Viewer",
        "icon": "resources/icon.icns"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer",
        "icon": "resources/icon.icns"
      }
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build_resources/node/src",
        "to": "node/src"
      },
      {
        "from": "build_resources/node/node_modules",
        "to": "node/node_modules"
      },
      {
        "from": "build_resources/node/package.json",
        "to": "node/package.json"
      },
      {
        "from": "build_resources/node/package-lock.json",
        "to": "node/package-lock.json"
      },
      {
        "from": "build_resources/ui",
        "to": "ui"
      }
    ],
    "dmg": {
      "icon": "resources/icon.icns"
    },
    "electronLanguages": [
      "en"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
